# Copy to .env for local development. Never commit the real .env file.
FLASK_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///property_management.db

# Required only when creating the first administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=HomeBridge Administrator
ADMIN_PHONE=

# Keep private files outside app/static and outside the public web root.
PRIVATE_UPLOAD_FOLDER=/var/lib/homebridge/private-uploads

# Optional email configuration.
MAIL_SERVER=smtp.zoho.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Business settings; configure the actual fee and payment instructions in Admin.
LISTING_FEE=20
PAYMENT_DETAILS=
